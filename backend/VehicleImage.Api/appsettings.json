{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "SqlServer",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=VehicleImageDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Storage": {
    "RootPath": "../../storage"
  },
  "Retrieval": {
    "MaxDownloadBytes": 20971520,
    "TimeoutSeconds": 15,
    "ConnectTimeoutSeconds": 5,
    "MaxRedirects": 5,
    "AllowedPorts": [ 80, 443 ],
    "MaxUrlLength": 2048,
    "UserAgent": "VehicleImageSystem/1.0",
    "PooledConnectionLifetimeSeconds": 60
  },
  "ImageValidation": {
    "AllowedFormats": [ "Jpeg", "Png", "WebP" ],
    "MinWidth": 100,
    "MinHeight": 100,
    "MaxWidth": 10000,
    "MaxHeight": 10000,
    "MaxPixels": 50000000
  },
  "HtmlExtraction": {
    "MaxCandidates": 3,
    "MinDeclaredDimension": 80,
    "IgnoreUrlPatterns": [
      "logo",
      "icon",
      "favicon",
      "sprite",
      "pixel",
      "tracking",
      "tracker",
      "banner",
      "badge",
      "avatar",
      "spinner",
      "loading",
      "placeholder",
      "1x1",
      "/ads/",
      "ad-",
      "ad_"
    ]
  },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelayMs": 150,
    "MaxDelayMs": 1500,
    "EnableJitter": true,
    "MaxRetryAfterSeconds": 3
  },
  "BulkImport": {
    "MaxRecords": 50,
    "MaxFileBytes": 1048576
  }
}
